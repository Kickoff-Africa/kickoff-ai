PORT=3000
DATABASE_URL=postgresql://user:password@localhost:5432/kickoffai
JWT_SECRET=your-jwt-secret-here
JWT_EXPIRY=24h
MAGIC_LINK_EXPIRY_MINUTES=15
USESEND_API_KEY=your-usesend-api-key
USESEND_BASE_URL=https://app.usesend.com/api
EMAIL_FROM=noreply@kickoff.africa
APP_URL=https://ai-api.kickoff.africa
FRONTEND_URL=https://ai.kickoff.africa
CORS_ORIGIN=https://kickoff.africa,https://app.kickoff.africa
ALLOWED_EMAIL_DOMAIN=kickoff.africa
ADMIN_EMAIL=work@kickoff.africa
# Inference backend: "ollama" (default) or "llamacpp" (llama.cpp llama-server, fully self-hosted).
# With llamacpp, the OLLAMA_*_MODEL names are only labels; the loaded GGUF decides the model.
LLM_BACKEND=ollama
LLAMACPP_BASE_URL=http://localhost:8080
LLAMACPP_EMBED_BASE_URL=http://localhost:8081
# LLAMACPP_VISION_BASE_URL=   (defaults to LLAMACPP_BASE_URL)
# LLAMACPP_API_KEY=           (only if llama-server runs with --api-key)

# Chat endpoint. Set to your self-hosted Ollama (e.g. http://<container>:11434) to avoid Ollama Cloud;
# chat is then queued one-at-a-time and OLLAMA_API_KEY can be left empty.
OLLAMA_CLOUD_BASE_URL=https://ollama.com
OLLAMA_API_KEY=your-ollama-cloud-api-key
OLLAMA_SIMPLE_MODEL=gpt-oss:120b-cloud
OLLAMA_MODERATE_MODEL=gpt-oss:120b-cloud
OLLAMA_COMPLEX_MODEL=gpt-oss:120b-cloud
OLLAMA_BASE_URL=http://203.161.52.27:11434
OLLAMA_VISION_MODEL=gemma3:4b
OLLAMA_EMBED_MODEL=nomic-embed-text
CHROMA_URL=http://chroma-s52xtz94wy3rvntobiepodqd.203.161.52.27.sslip.io
NODE_ENV=production
WHATSAPP_VERIFY_TOKEN=choose-a-random-string
WHATSAPP_ACCESS_TOKEN=your-meta-permanent-access-token
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
WHATSAPP_APP_SECRET=your-meta-app-secret
